SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=dummy-service-role-key
# Chỉ cần khi project Supabase còn ký JWT bằng khóa bí mật cũ (HS256).
# Để trống nếu project dùng khóa ký bất đối xứng (JWKS).
SUPABASE_JWT_SECRET=
# Danh sách nguồn được phép gọi API, cách nhau bằng dấu phẩy.
CORS_ORIGINS=http://localhost:5174
PORT=5050
